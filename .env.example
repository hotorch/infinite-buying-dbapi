# Non-secret settings only. Store DB Securities credentials with `app setup`.
# 기본 저장 위치를 바꿔야 할 때만 아래 주석을 해제하세요.
# IB_DB_PATH=C:\Users\사용자이름\AppData\Local\InfiniteBuyingDBAPI\state.sqlite3
IB_ACCOUNT_ALIAS=default
IB_ENVIRONMENT=preview
IB_DBSEC_BASE_URL=https://openapi.dbsec.co.kr:8443
# DB증권 이용절차 페이지 기준은 json. 다운로드 OAuth 명세를 따라야 할 때만 form으로 변경합니다.
IB_DBSEC_OAUTH_STYLE=json
# Required for live mode. Enter the lowest official rate among every TR in use.
# IB_DBSEC_REQUESTS_PER_SECOND=공식확인값
IB_MAX_ORDER_NOTIONAL_USD=1000
IB_MAX_DAILY_NOTIONAL_USD=2000
